{
  "name": "escoresheet",
  "version": "2.4.2",
  "private": true,
  "type": "module",
  "main": "electron/main.js",
  "description": "Open Source Volleyball eScoresheet",
  "author": "Luca Canepa <luca.canepa@gmail.com>",
  "homepage": "https://github.com/lucacanepa/openvolley",
  "repository": {
    "type": "git",
    "url": "https://github.com/lucacanepa/openvolley"
  },
  "scripts": {
    "dev": "vite",
    "dev:https": "cross-env VITE_HTTPS=true vite",
    "build": "vite build",
    "tauri": "tauri",
    "build:subdomains": "node scripts/build-subdomains.js",
    "build:referee": "node scripts/build-subdomains.js referee",
    "build:bench": "node scripts/build-subdomains.js bench",
    "build:livescore": "node scripts/build-subdomains.js livescore",
    "build:roster": "node scripts/build-subdomains.js roster",
    "build:app": "node scripts/build-subdomains.js app",
    "build:manager": "node scripts/build-subdomains.js manager",
    "build:manager-beach": "node scripts/build-subdomains.js manager-beach",
    "preview": "vite preview",
    "start": "node server.js",
    "start:prod": "npm run build && node server.js",
    "start:https": "cross-env HTTPS=true node server.js",
    "start:prod:https": "npm run build && cross-env HTTPS=true node server.js",
    "generate-certs": "node generate-certs.js",
    "electron:dev": "concurrently \"npm run dev\" \"wait-on http://localhost:5173 && electron electron/main.js\"",
    "electron:clean": "node -e \"const fs=require('fs'); try{fs.rmSync('dist-electron',{recursive:true,force:true})}catch(e){console.log('Clean failed, continuing...')}\"",
    "electron:build": "npm run electron:clean && cross-env ELECTRON=true npm run build && electron-builder",
    "electron:build:win": "npm run electron:clean && cross-env ELECTRON=true npm run build && electron-builder --win",
    "electron:build:win:pwsh": "npm run electron:clean && $env:ELECTRON='true'; npm run build; electron-builder --win",
    "electron:build:mac": "npm run electron:clean && cross-env ELECTRON=true npm run build && electron-builder --mac",
    "electron:build:linux": "npm run electron:clean && cross-env ELECTRON=true npm run build && electron-builder --linux",
    "cap:sync": "cap sync",
    "cap:open:android": "cap open android",
    "cap:open:ios": "cap open ios",
    "cap:build:android": "npm run build && cap sync android",
    "cap:build:ios": "npm run build && cap sync ios",
    "translate": "node scripts/translate.js",
    "translate:dry": "node scripts/translate.js --dry-run",
    "postinstall": "node scripts/install-hooks.js",
    "test": "vitest",
    "test:run": "vitest run",
    "test:coverage": "vitest run --coverage",
    "check:i18n": "node scripts/check-i18n-keys.js"
  },
  "dependencies": {
    "@capacitor/filesystem": "^8.1.4",
    "@capacitor/screen-orientation": "^8.0.2",
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@fontsource/jetbrains-mono": "^5.3.0",
    "@fontsource/orbitron": "^5.3.0",
    "@fontsource/roboto-mono": "^5.3.0",
    "@fontsource/space-mono": "^5.3.0",
    "@phosphor-icons/react": "^2.1.10",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "dexie": "^4.3.0",
    "dexie-react-hooks": "^4.2.0",
    "fflate": "^0.8.3",
    "html-to-image": "^1.11.13",
    "html5-qrcode": "^2.3.8",
    "i18next": "^26.4.3",
    "jspdf": "^4.1.0",
    "jszip": "^3.10.1",
    "lucide-react": "^1.52.0",
    "pdfjs-dist": "~5.5.207",
    "qrcode.react": "^4.2.0",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "react-i18next": "^17.0.16",
    "serve": "^14.2.5",
    "tailwind-merge": "^3.7.0",
    "ws": "^8.21.0"
  },
  "devDependencies": {
    "@capacitor/android": "^8.5.3",
    "@capacitor/cli": "^8.5.3",
    "@capacitor/core": "^8.5.3",
    "@capacitor/ios": "^8.5.3",
    "@tailwindcss/vite": "^4.3.2",
    "@tauri-apps/cli": "^2.12.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.2",
    "@vitejs/plugin-react": "^5.1.4",
    "concurrently": "^10.0.6",
    "cross-env": "^10.1.0",
    "dotenv": "^18.0.7",
    "fake-indexeddb": "^6.2.5",
    "jsdom": "^28.1.0",
    "rimraf": "^6.1.3",
    "tailwindcss": "^4.3.2",
    "vite": "^7.3.6",
    "vite-plugin-pwa": "^1.2.0",
    "vitest": "^4.0.18",
    "wait-on": "^9.0.4"
  },
  "optionalDependencies": {
    "electron": "^40.4.1",
    "electron-builder": "^26.8.1"
  },
  "build": {
    "appId": "com.openvolley.escoresheet",
    "productName": "Openvolley eScoresheet",
    "directories": {
      "output": "dist-electron"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "lucacanepa",
        "repo": "openvolley"
      }
    ],
    "npmRebuild": false,
    "files": [
      "dist/**/*",
      "electron/**/*",
      "!electron/README.md",
      "package.json"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64",
            "ia32"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "electron/icon.ico"
    },
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "x64",
            "arm64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ],
      "icon": "electron/icon.icns",
      "category": "public.app-category.sports"
    },
    "linux": {
      "target": [
        {
          "target": "AppImage",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "deb",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "rpm",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "electron/icon.png",
      "category": "Utility"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    }
  }
}
