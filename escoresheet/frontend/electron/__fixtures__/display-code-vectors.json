 "scenarios": [
  {
   "name": "set, look up, revoke",
   "steps": [
    {
     "op": "set",
     "room": "room-1",
     "code": "ABCD2345",
     "issuedAt": 0,
     "expect": {
      "ok": true,
      "endsAt": 43200000
     }
    },
    {
     "op": "resolve",
     "code": "abcd-2345",
     "expect": {
      "ok": true,
      "room": "room-1",
      "endsAt": 43200000
     }
    },
    {
     "op": "resolve",
     "code": " ABCD 2345 ",
     "expect": {
      "ok": true,
      "room": "room-1",
      "endsAt": 43200000
     }
    },
    {
     "op": "codeOfRoom",
     "room": "room-1",
     "expect": {
      "endsAt": 43200000
     }
    },
    {
     "op": "isLive",
     "code": "ABCD2345",
     "room": "room-1",
     "expect": true
    },
    {
     "op": "isLive",
     "code": "ABCD2345",
     "room": "room-2",
     "expect": false
    },
    {
     "op": "stats",
     "expect": {
      "codes": 1,
      "tombstones": 0
     }
    },
    {
     "op": "ends",
     "expect": []
    },
    {
     "op": "revoke",
     "room": "room-1",
     "expect": true
    },
    {
     "op": "ends",
     "expect": [
      [
       "room-1",
       "revoked"
      ]
     ]
    },
    {
     "op": "resolve",
     "code": "ABCD2345",
     "expect": {
      "ok": false,
      "reason": "ended"
     }
    },
    {
     "op": "revoke",
     "room": "room-1",
     "expect": false
    },
    {
     "op": "codeOfRoom",
     "room": "room-1",
     "expect": null
    },
    {
     "op": "isLive",
     "code": "ABCD2345",
     "room": "room-1",
     "expect": false
    },
    {
     "op": "stats",
     "expect": {
      "codes": 0,
      "tombstones": 1
     }
    }
   ]
  },
  {
