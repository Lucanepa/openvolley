     "op": "set",
     "room": "room-1",
     "code": null,
     "expect": {
      "ok": false,
      "reason": "revoked"
     }
    },
    {
     "op": "ends",
     "expect": [
      [
       "room-1",
       "revoked"
      ]
     ]
    },
    {
     "op": "set",
     "room": "room-9",
     "code": null,
     "expect": {
      "ok": false,
      "reason": "revoked"
     }
    },
    {
     "op": "ends",
     "expect": []
    }
   ]
  },
