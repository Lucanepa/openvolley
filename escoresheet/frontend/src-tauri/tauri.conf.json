{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Openvolley eScoresheet",
  "version": "1.20.0",
  "identifier": "com.openvolley.escoresheet",
  "build": {
    "frontendDist": "../dist",
    "beforeBuildCommand": "npm run build",
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:5173"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "appimage", "deb"],
    "category": "Sports",
    "shortDescription": "Offline volleyball scoretable + LAN tablet server",
    "longDescription": "Fully offline volleyball e-scoresheet. Runs the scoretable and a built-in LAN server so referee, bench and livescore tablets connect over the same Wi-Fi — no internet, no accounts.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {}
}
