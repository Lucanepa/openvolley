<?xml version="1.0" encoding="utf-8"?>
<!-- firewalld zone of the networks OpenBeach starts for the tablets and court
     displays (its Wi-Fi hotspot and Bluetooth network, src/netshare/nm_settings.rs
     TABLET_ZONE). The devices get an address (DHCP), names (DNS) and the
     app's built-in server (5174 pages, 8081 live updates); every other port
     of this computer stays closed to them, and nothing is forwarded to its
     other networks. Installed by the .deb to /usr/lib/firewalld/zones. -->
<zone>
  <short>OpenBeach tablets</short>
  <description>Tablets and court displays on the network OpenBeach starts: DHCP, DNS and the app's built-in server only.</description>
  <service name="dhcp"/>
  <service name="dns"/>
  <port protocol="tcp" port="5174"/>
  <port protocol="tcp" port="8081"/>
  <protocol value="icmp"/>
</zone>
