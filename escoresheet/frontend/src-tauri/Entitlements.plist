<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- The macOS app's entitlements (both apps). Notarization needs the hardened
     runtime (tauri.macos.conf.json), which blocks the camera unless it is
     entitled: the QR scanner uses it (NSCameraUsageDescription in Info.plist). -->
<plist version="1.0">
<dict>
  <key>com.apple.security.device.camera</key>
  <true/>
</dict>
</plist>
