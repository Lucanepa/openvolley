# LedBox C0270 — [DISPLAY] reference (from Tech4Sport "impostazioni_display" sheet)
#
# This is ONLY the [DISPLAY] section. The board's real /home/pi/ledbox/setting.ini
# also has [WIFI] etc. — DO NOT copy this file over the whole thing. Edit the
# [DISPLAY] block in place. `bin/startled` reads these values and passes them to
# flushBuffer on every start.
#
# ─────────────────────────────────────────────────────────────────────────────
# CRITICAL: multiplexing / pwm_bits / hardware_mapping describe the PHYSICAL panel.
# They are NOT preferences. Setting the wrong multiplexing scrambles the panel into
# garbage — and because flushBuffer only changes how the panel is DRIVEN (not the
# source buffer.png), a scramble is INVISIBLE over the network. Only change these
# with a human watching the physical panel, and keep the old values to roll back.
# ─────────────────────────────────────────────────────────────────────────────
#
# The four vendor profiles (Model = board+environment):
#
#   param                 A: Pi3 indoor  C: Pi4 indoor  B: Pi3 outdoor  D: Pi4 outdoor
#   hardware_mapping      applicon       applicon       applicon        applicon
#   pwm_lsb_nanoseconds   500            180            500             450
#   slowdown_gpio         2              3              5               5
#   pwm_bits              5              7              5               7
#   multiplexing          0              0              1               1
#   brightness            100            100            100             100
#   no_hardware_pulsing   0              0              0               0
#   pwm_dither            2              2              2               2
#
# KSC Wiedikon's panel is a **Pi 4 + OUTDOOR panel → Model D** (confirmed: the panel
# is physically an outdoor unit; it is also usable for beach volleyball outdoors).
# The values below are Model D and are CORRECT for this hardware. Do NOT switch to
# the indoor (Model C) column — multiplexing=0 would scramble this panel.

[DISPLAY]
hardware_mapping=applicon
pwm_lsb_nanoseconds=450
slowdown_gpio=5
pwm_bits=7
multiplexing=1
no_hardware_pulsing=0
pwm_dither=2

# brightness is the one SAFE knob here (it never scrambles, only dims/brightens).
#   40  → current value; good for the indoor hall (an outdoor panel at 100 indoors
#         is glaring).
#   ~100 → set this when the panel is used OUTDOORS / for beach in daylight, or 40
#          is unreadable in sunlight.
brightness=40

# Physical panel geometry (do not change): 192x64.
width=192
height=64
# Vendor's internal virtual canvas passed to flushBuffer as --screen-dimension.
screen_width=640
screen_height=480
