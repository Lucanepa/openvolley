<?xml version='1.0'?>
<layout name="basketball_matchscore" modifier="">
  <!-- Basketball scoreboard for the 192x64 HUB75 panel. Modelled on volleyball_matchscore_02
       but basketball-specific: a CUMULATIVE running score, a centre PERIOD indicator
       (Q1..Q4 / OT1 / FINAL) in place of the two-number set line, a per-side TEAM-FOUL
       counter (F) with a bonus/penalty marker, a per-side TIMEOUT counter (T), and the serve
       bars reused as the possession (alternating-possession arrow) indicator. Section names
       are shared with the volleyball layout where the geometry matches, so the web
       board-mirror and the mapper stay familiar; the basketball-specific sections are
       `period`, `foul1/2`, `lbl_foul` and `bonus1/2`. The game clock is deliberately NOT here
       (a documented phase-2 / hardware item — see docs/basketball-DESIGN.md). -->
  <section name="team1" type="text" x="0" y="-4" visible="true" private="false" enable="true" fontsize="18" color="37, 99, 235" align="left" animation="" animation_params="">HOME</section>
  <section name="bonus1" type="text" x="60" y="0" visible="true" private="false" enable="true" fontsize="15" color="40, 40, 40" align="center" animation="" animation_params=""></section>
  <section name="bg_score1" type="rectangle" x="0" y="17" visible="true" private="true" enable="true" color="0, 0, 0" bordercolor="37, 99, 235" width="64" height="46" animation="" animation_params="">bg1</section>
  <section name="score1" type="text" x="32" y="2" visible="true" private="false" enable="true" fontsize="55" color="37, 99, 235" align="center" animation="" animation_params="">0</section>
  <section name="period" type="text" x="96" y="-6" visible="true" private="false" enable="true" fontsize="15" color="255, 255, 255" align="center" animation="" animation_params="">Q1</section>
  <section name="foul1" type="text" x="80" y="22" visible="true" private="false" enable="true" fontsize="15" color="200, 200, 200" align="center" animation="" animation_params="">0</section>
  <section name="lbl_foul" type="text" x="96" y="25" visible="true" private="true" enable="true" fontsize="11" color="170, 184, 216" align="center" animation="" animation_params="">F</section>
  <section name="foul2" type="text" x="112" y="22" visible="true" private="false" enable="true" fontsize="15" color="200, 200, 200" align="center" animation="" animation_params="">0</section>
  <section name="timeout1" type="text" x="80" y="38" visible="true" private="false" enable="true" fontsize="15" color="200, 200, 200" align="center" animation="" animation_params="">0</section>
  <section name="lbl_to" type="text" x="96" y="41" visible="true" private="true" enable="true" fontsize="11" color="170, 184, 216" align="center" animation="" animation_params="">T</section>
  <section name="timeout2" type="text" x="112" y="38" visible="true" private="false" enable="true" fontsize="15" color="200, 200, 200" align="center" animation="" animation_params="">0</section>
  <section name="serve1" type="rectangle" x="70" y="60" visible="true" private="false" enable="true" color="255, 255, 255" bordercolor="0, 0, 0" width="16" height="5" animation="" animation_params="">s1</section>
  <section name="serve2" type="rectangle" x="107" y="60" visible="true" private="false" enable="true" color="0, 0, 0" bordercolor="0, 0, 0" width="16" height="5" animation="" animation_params="">s2</section>
  <section name="team2" type="text" x="192" y="-4" visible="true" private="false" enable="true" fontsize="18" color="255, 69, 0" align="right" animation="" animation_params="">GUEST</section>
  <section name="bonus2" type="text" x="132" y="0" visible="true" private="false" enable="true" fontsize="15" color="40, 40, 40" align="center" animation="" animation_params=""></section>
  <section name="bg_score2" type="rectangle" x="127" y="17" visible="true" private="true" enable="true" color="0, 0, 0" bordercolor="255, 69, 0" width="64" height="46" animation="" animation_params="">bg2</section>
  <section name="score2" type="text" x="160" y="2" visible="true" private="false" enable="true" fontsize="55" color="255, 69, 0" align="center" animation="" animation_params="">0</section>
</layout>
