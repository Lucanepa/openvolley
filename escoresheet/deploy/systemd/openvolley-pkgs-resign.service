# lenovoserver only (holds the APT signing key). Signs the APT index of
# get.openvolley.app anew, so its Valid-Until (30 days, publish-pkgs.sh step 2)
# never runs out between releases: publish-pkgs.sh --resign signs the index of
# the pool already published again and syncs apt/dists/ only (no page,
# install.sh, F-Droid or new package). It runs from its own checkout, never the
# shared working copy (other sessions switch its branch): a detached checkout of
# main that nothing else uses, refused when it has local changes or its HEAD is
# not on origin/main. Install, before the first publish with Valid-Until:
#   git -C ~/repos/openvolley worktree add --detach ~/ov-ops/pkgs-resign origin/main
#   sudo install -m 644 openvolley-pkgs-resign.service openvolley-pkgs-resign.timer /etc/systemd/system/
#   sudo systemctl daemon-reload && sudo systemctl enable --now openvolley-pkgs-resign.timer
#   sudo systemctl start openvolley-pkgs-resign.service   # once, then: journalctl -u openvolley-pkgs-resign
# Move it to a newer main only after reading what changed in escoresheet/deploy/:
#   git -C ~/ov-ops/pkgs-resign checkout --detach origin/main
# Set OV_PKGS_KUMA_PUSH_URL in resign.env (an Uptime Kuma push monitor,
# heartbeat about 8 days): it then alerts on a failed run and on no run at all.
# Adjust User= and the paths below if the ops checkout lives elsewhere. The
# sync needs the publish user's ssh key for ov-vps without a prompt.
[Unit]
Description=OpenVolley package index re-sign (APT Valid-Until), weekly
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot
User=lucanepa
# Optional overrides (OV_PKGS_HOME, OV_PKGS_DEST, OV_PKGS_KUMA_PUSH_URL, ...).
EnvironmentFile=-/home/lucanepa/.config/openvolley-pkgs/resign.env
ExecStart=/home/lucanepa/ov-ops/pkgs-resign/escoresheet/deploy/publish-pkgs.sh --resign
TimeoutStartSec=15min
Nice=10
NoNewPrivileges=yes
