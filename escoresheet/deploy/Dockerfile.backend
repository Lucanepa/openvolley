# syntax=docker/dockerfile:1
#
# OpenVolley cloud backend image.
#
# Packages escoresheet/backend (server.js + whatever lib/, db/, scripts/ the
# self-host wiring adds). Build context is escoresheet/backend; this file and
# its ignore list live in escoresheet/deploy so the backend directory stays
# untouched:
#
#   docker build -f escoresheet/deploy/Dockerfile.backend \
#                -t openvolley-backend:$(git rev-parse --short HEAD) escoresheet/backend
#
# or simply escoresheet/deploy/build-image.sh.
#
# Runtime contract (see README.md): PORT (8080), DATABASE_URL, STORAGE_ROOT,
# STATUS_DIR, PUBLIC_ORIGINS, TRUST_PROXY, RESEND_*/SMTP_*. HTTP and WebSocket
# share PORT (ws attaches to the http server via upgrade).
#
# The image runs as the unprivileged `node` user (uid 1000) and never writes
# outside /tmp, STORAGE_ROOT and its own process memory, so it works with
# `read_only: true` + a tmpfs on /tmp.

ARG NODE_IMAGE=node:22.23.3-bookworm-slim

FROM ${NODE_IMAGE} AS deps
WORKDIR /app
COPY package.json package-lock.json ./
# --ignore-scripts: no runtime dependency needs an install script (ws, pg,
# bcryptjs, nodemailer, qrcode are pure JS); this keeps the build hermetic.
RUN npm ci --omit=dev --ignore-scripts --no-audit --no-fund \
 && npm cache clean --force

FROM ${NODE_IMAGE}
ARG OV_REVISION=unknown
LABEL org.opencontainers.image.title="openvolley-backend" \
      org.opencontainers.image.source="https://github.com/Lucanepa/openvolley" \
      org.opencontainers.image.revision="${OV_REVISION}"

ENV NODE_ENV=production \
    PORT=8080 \
    STORAGE_ROOT=/data/storage \
    STATUS_DIR=/var/lib/openvolley-status \
    OV_REVISION=${OV_REVISION} \
    NPM_CONFIG_UPDATE_NOTIFIER=false

WORKDIR /app
# Everything owned by root and not writable by `node`: the app cannot modify
# its own code even if the rootfs were mounted read-write.
COPY --from=deps /app/node_modules ./node_modules
COPY . .
COPY <<'EOF' /usr/local/lib/openvolley/healthcheck.cjs
// Docker liveness probe. Exit 0 = healthy. Never touches the database.
// Deliberately NO fallback to /health: an image built from a tree without the
// self-host wiring (no /health/live) must never become healthy, so ov-tunnel
// (depends_on: service_healthy) never starts in front of it.
// Watchdog: after OV_WATCHDOG_FAILURES consecutive failed /health/live checks
// (a hung event loop; 0 or unset = off) it kills the server whose pid is in
// OV_PID_FILE (server.js writes it), with SIGKILL: a hung loop runs no SIGTERM
// handler. With compose's init: true the server is not PID 1, so the
// container exits and `restart: unless-stopped` starts it again.
const fs = require('fs')
const port = process.env.PORT || 8080
const root = process.env.STORAGE_ROOT
const COUNT = process.env.OV_WATCHDOG_COUNT_FILE || '/tmp/ov-health-failures'
const limit = Number(process.env.OV_WATCHDOG_FAILURES || 0) | 0
if (root && !fs.existsSync(`${root}/.ovdata`)) process.exit(1) // storage fs not mounted
function failed() {
  let n = 0
  try { n = Number(fs.readFileSync(COUNT, 'utf8')) | 0 } catch {}
  n++
  try { fs.writeFileSync(COUNT, String(n)) } catch {}
  if (limit > 0 && n >= limit && process.env.OV_PID_FILE) {
    let pid = 0
    try { pid = Number(fs.readFileSync(process.env.OV_PID_FILE, 'utf8')) | 0 } catch {}
    if (pid > 1) {
      console.error(`watchdog: /health/live failed ${n} times in a row, killing the server (pid ${pid})`)
      try { process.kill(pid, 'SIGKILL') } catch {}
      try { fs.unlinkSync(COUNT) } catch {}
    }
  }
  process.exit(1)
}
fetch(`http://127.0.0.1:${port}/health/live`, { signal: AbortSignal.timeout(4000) })
  .then((r) => {
    if (r.status !== 200) return failed()
    try { fs.unlinkSync(COUNT) } catch {}
    process.exit(0)
  })
  .catch(failed)
EOF
USER node
EXPOSE 8080

# Liveness only (no database), with the watchdog above; monitors and
# restore-test.sh use /health (readiness).
# Unhealthy when /health/live is missing (pre-wiring tree) or the storage
# sentinel is absent. build-image.sh also refuses to build a pre-wiring tree.
HEALTHCHECK --interval=15s --timeout=5s --start-period=20s --retries=3 \
  CMD ["node", "/usr/local/lib/openvolley/healthcheck.cjs"]

CMD ["node", "server.js"]
