# ov-pkgs: static file server for https://get.openvolley.app
#
# Serves /srv/pkgs (read-only bind of /data/openvolley/pkgs, filled by
# publish-pkgs.sh from lenovoserver):
#   /               index.html (install instructions)
#   /install.sh     one-line installer (curl -fsSL https://get.openvolley.app/install.sh | sudo sh)
#   /apt/           signed APT repository (dists/stable, pool/main, openvolley.gpg/.asc)
#   /fdroid/repo/   signed F-Droid repository
#   /desktop/       desktop updater manifests: latest.json, staging.json,
#                   latest-<version>.json (publish-pkgs.sh --desktop)
#   /flatpak/       signed Flatpak (OSTree) repository repo/, openvolley.flatpakrepo,
#                   <app id>.flatpakref (packaging/flatpak/publish-flatpak.sh)
#   /arch/          signed pacman repository: openvolley.gpg, fingerprint.txt,
#                   x86_64/{openvolley.db,openvolley.files,*.pkg.tar.zst} and their .sig
#                   (packaging/pacman/publish-pacman.sh)
#
# TLS ends at Cloudflare; ov-tunnel reaches this on http://ov-pkgs:80 over the
# compose network ov-edge. No admin API, no ACME, no state on disk.
{
	admin off
	auto_https off
	persist_config off
}

:80 {
	root * /srv/pkgs

	# Read-only site: anything but GET/HEAD is refused.
	@write not method GET HEAD
	respond @write 405

	# Content types file_server would otherwise guess or leave generic.
	@deb path *.deb
	@apk path *.apk
	@jar path *.jar
	@json path *.json
	@keyring path *.gpg
	@armored path *.asc
	@release path */InRelease */Release
	@detached path */Release.gpg
	@script path /install.sh
	@flatpakref path *.flatpakref
	@flatpakrepo path *.flatpakrepo
	# pacman: the databases (gzip tar), the packages (zstd tar), detached signatures
	@pacmandb path /arch/*/*.db /arch/*/*.files
	@pacmanpkg path /arch/*/*.pkg.tar.zst
	@pacmansig path /arch/*/*.sig
	header @deb Content-Type application/vnd.debian.binary-package
	header @apk Content-Type application/vnd.android.package-archive
	header @jar Content-Type application/java-archive
	header @json Content-Type "application/json; charset=utf-8"
	header @keyring Content-Type application/pgp-keys
	header @armored Content-Type "text/plain; charset=utf-8"
	header @release Content-Type "text/plain; charset=utf-8"
	header @detached Content-Type application/pgp-signature
	# Shown as text in a browser (read it before piping it to sh).
	header @script Content-Type "text/plain; charset=utf-8"
	# Opened by the software centre (GNOME Software, Discover) from a browser.
	header @flatpakref Content-Type application/vnd.flatpak.ref
	header @flatpakrepo Content-Type application/vnd.flatpak.repo
	# octet-stream and zstd are never re-compressed by encode below (pacman
	# checks the bytes it gets against the signature)
	header @pacmandb Content-Type application/octet-stream
	header @pacmanpkg Content-Type application/zstd
	header @pacmansig Content-Type application/pgp-signature

	# Caching: packages are named by version and never rewritten, so they are
	# immutable. Everything else (APT dists/, F-Droid index and entry files,
	# keys, this page, listings) changes on every publish: 60 s, revalidate.
	# OSTree objects are named by the hash of their content, so
	# immutable too; the Flatpak summary, refs and deltas are not.
	# pacman packages (name-version-pkgrel) and their signatures never change.
	# The pacman database and its signature are fetched as a pair on every
	# pacman -Sy: never cached, so a client never gets a new database with an
	# old signature (pacman sends If-Modified-Since, so this costs a 304).
	@immutable path *.deb *.apk /flatpak/repo/objects/* /arch/*/*.pkg.tar.zst /arch/*/*.pkg.tar.zst.sig
	@nocache path /arch/*/*.db /arch/*/*.db.sig /arch/*/*.files /arch/*/*.files.sig
	@mutable not path *.deb *.apk /flatpak/repo/objects/* /arch/*/*.pkg.tar.zst /arch/*/*.pkg.tar.zst.sig /arch/*/*.db /arch/*/*.db.sig /arch/*/*.files /arch/*/*.files.sig
	header @immutable Cache-Control "public, max-age=31536000, immutable"
	header @nocache Cache-Control "no-cache"
	header @mutable Cache-Control "public, max-age=60, must-revalidate"

	# The Android app (sideloaded installs, opt-in) reads the F-Droid index to
	# see whether a newer version is out; its WebView origin is not this host.
	# A plain GET needs no preflight. Nothing else is readable cross-origin.
	@fdroidindex path /fdroid/repo/index-v2.json
	header @fdroidindex Access-Control-Allow-Origin *

	header {
		X-Content-Type-Options nosniff
		Referrer-Policy no-referrer
		X-Frame-Options DENY
		-Server
	}

	encode zstd gzip
	file_server browse {
		hide .*
	}

	# Errors (404 and the like) bypass the header rules above.
	handle_errors {
		header {
			Content-Type "text/plain; charset=utf-8"
			Cache-Control "public, max-age=60"
			X-Content-Type-Options nosniff
			-Server
		}
		respond "{err.status_code} {err.status_text}"
	}
}
