# Template for /opt/openvolley/.env
#   install -m 600 env.example .env   (then fill it in; owner root)
#
# Read by `docker compose` for interpolation only. Each container receives
# just the variables compose.yaml hands it: the tunnel token never reaches the
# backend, the owner password never reaches the backend or the tunnel.
#
# NEVER `source` / `set -a; . .env` this file into a shell. Docker Compose
# gives variables exported in the calling shell priority over .env, so in that
# shell every later `docker compose up` silently keeps the exported values
# (an edited OV_BACKEND_IMAGE or OV_MIN_MATCHES would be ignored). Scripts that
# need one value (apply-roles.sh) extract just that value.
#
# Generate passwords as hex so they are safe inside DATABASE_URL:
#   openssl rand -hex 32

# --- Images -----------------------------------------------------------------
# Built on lenovoserver with build-image.sh and loaded here; tag = git short SHA.
# Rollback = put the previous tag back and `docker compose up -d ov-backend`.
OV_BACKEND_IMAGE=openvolley-backend:REPLACE_WITH_GIT_SHA
OV_POSTGRES_IMAGE=postgres:17.12-alpine
OV_CLOUDFLARED_IMAGE=cloudflare/cloudflared:2026.10.3

# --- Host paths (host-prep.sh creates them) -----------------------------------
# Loop filesystem mountpoints; each contains a .ovdata sentinel when mounted.
OV_PG_HOST_DIR=/data/openvolley/pg
OV_STORAGE_HOST_DIR=/data/openvolley/storage
# Holds last_backup (written by backup-openvolley.sh), mounted read-only.
OV_STATUS_HOST_DIR=/var/lib/openvolley-status

# --- Postgres ---------------------------------------------------------------
# Superuser of the OpenVolley cluster: restores, roles.sql, backups (docker exec).
OV_OWNER_PW=
# Login of the backend (role ov_app, created/updated by db/roles.sql).
OV_APP_PW=
# Optional: login of ov_readonly over TCP, for `db-browse.sh web` (pgweb).
# Without it `db-browse.sh psql` still works. openssl rand -hex 32, then
# ./apply-roles.sh < roles.sql once.
OV_READONLY_PW=
# /health "floor": 90% of the matches count after the production restore.
OV_MIN_MATCHES=0

# --- Cloudflare Tunnel ------------------------------------------------------
# `cloudflared tunnel token openvolley`. Only the PRODUCTION host (ov-vps) has
# these two lines filled in: ov-tunnel is in the compose profile "tunnel", so a
# fallback or test host with COMPOSE_PROFILES empty and no TUNNEL_TOKEN starts
# no second connector (Cloudflare would balance between two databases). A
# move: set both on the new host, then remove them on the old one.
COMPOSE_PROFILES=
TUNNEL_TOKEN=

# --- Backend (HTTP + WS on port 8080 inside the compose network) -------------
# Comma-separated list of allowed browser origins (CORS).
# Production lists no dev-*.openvolley.app sites and no *.pages.dev previews:
# dev-branch builds use the test backend, whose .env lists them (owner
# decision 5, docs/manager-site-deploy.md "Dev builds and the test backend").
# A cloud backend drops such entries at the start and logs them loudly
# (SEC-60), unless OV_ALLOW_DEV_ORIGINS=1: set that on the TEST backend only.
OV_ALLOW_DEV_ORIGINS=
PUBLIC_ORIGINS=https://app.openvolley.app,https://referee.openvolley.app,https://bench.openvolley.app,https://livescore.openvolley.app,https://roster.openvolley.app,https://scoresheet.openvolley.app,https://beach.openvolley.app,https://manager.openvolley.app
# DATABASE_URL, STORAGE_ROOT, STATUS_DIR, PORT and TRUST_PROXY=cloudflare are
# fixed in compose.yaml and are not read from here.
# cf-connecting-ip is trusted only from this peer: the tunnel's fixed address
# on ov-edge (compose.yaml). Empty = that default; the backend refuses to start
# in cloud mode without it.
TRUST_PROXY_FROM=
# Capacity (empty = compose defaults: pool 5, heap 256 MB of a 512m backend,
# 1 CPU, Postgres 0.5 CPU). The peak load test (README.md "Capacity and limits for big events") asks for
# PG_POOL_MAX=10, OV_BACKEND_CPUS=2, OV_PG_CPUS=1 on a big match day; raise
# OV_NODE_HEAP_MB with OV_BACKEND_MEM (heap about half of it), and keep the
# sum of CPUs within the host's. Re-run the peak harness after a change.
PG_POOL_MAX=
OV_NODE_HEAP_MB=
OV_BACKEND_MEM=
OV_BACKEND_CPUS=
OV_PG_CPUS=
# Worker threads for password hashing (sign-in, sign-up, reset; off the
# relay's event loop). Empty = 1; 0 = on the main thread. With
# OV_BACKEND_CPUS=2 on a big match day, 2.
OV_BCRYPT_WORKERS=
# An address with 100 failed sign-ins in 24 h (db/057, lib/auth.js
# accountCeiling): its sources that signed in before, or opened one of its
# reset or confirmation links, go on as usual. The others:
#   account (empty, default) one try per interval (1 min, doubling, at most
#           1 h) for all of them together: a botnet guesses no faster than one
#           source, and the owner's new devices and networks wait with it
#   lane    one try per client lane (an IPv6 /48, an IPv4 address) and
#           interval: the owner's own network keeps its tries, a botnet gets
#           one per lane
OV_SIGN_IN_CEILING_SLOTS=
# New sockets get "relay busy" while the heap stays above this % of the heap
# limit after a major GC (default 85); garbage before a GC does not count;
# failed /health/live checks before the watchdog restarts the backend (4)
OV_ADMIT_HEAP_PCT=
OV_WATCHDOG_FAILURES=

# --- Mail --------------------------------------------------------------------
# Resend: only for a backend without the SMTP settings below. The game PIN and
# match information mails a scorer asks for (send-pin, send-info) go over SMTP
# when it is set, else over Resend; with neither they answer 503.
RESEND_API_KEY=
# Quoted: unquoted, the '<' would make the line a shell syntax error.
RESEND_FROM='eScoresheet <escoresheet@openvolley.app>'
# Time zone of the match time in the match information mail (IANA name).
OV_TIMEZONE=Europe/Zurich
# Account emails (backend README "Account emails"): password-reset links,
# confirmation links for new accounts, "your password was changed" notices,
# and the game PIN / match information a scorer asks for to its own address.
# Without SMTP_HOST and SMTP_PASS the backend sends none: reset answers 503
# ("temporarily unavailable, contact CONTACT_EMAIL") and sign-up confirms the
# account at once. With either set, a missing or unusable mail setting (also
# MAIL_FROM_BEACH, MANAGER_URL_BEACH) stops the backend at startup. Set them with ~/ov-ops/set-smtp-password.sh (lenovoserver),
# which keeps the password in Vaultwarden and out of shell history.
#   SMTP_PORT  465 = implicit TLS (default); 587 = STARTTLS (required). Hetzner
#              blocks outgoing 465 on new servers: use 587 if 465 times out.
#   SMTP_PASS  the mailbox password. Single-quoted, no ' in it.
#   MAIL_FROM  quoted (contains < >); default: OpenVolley <SMTP_USER>
#   MANAGER_URL base of the links in the mails (default below)
#   MAIL_FROM_BEACH / MANAGER_URL_BEACH  the same for OpenBeach (a sign-up,
#              reset or resend with app: 'beach'). Defaults: OpenBeach <the
#              address of MAIL_FROM>, and for MANAGER_URL_BEACH one that
#              follows MANAGER_URL: https://manager-beach.openvolley.app for the
#              default MANAGER_URL, .../manager-beach.html for a .../manager.html
#              or a bare http://localhost:<port> (dev), else MANAGER_URL itself
#              with a "[Mail] MANAGER_URL_BEACH is not set" warning at startup.
#              So a test or staging backend never links to production's
#              manager-beach (which does not know its tokens): set both there.
#              A value that is set but unusable turns all account mails off.
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=
MAIL_FROM='OpenVolley <noreply@openvolley.app>'
MANAGER_URL=https://manager.openvolley.app
MAIL_FROM_BEACH='OpenBeach <noreply@openvolley.app>'
MANAGER_URL_BEACH=https://manager-beach.openvolley.app
# Mails per hour, all recipients together (lib/mailer.js BUDGET_ENV): the
# final scoresheets of official matches (default 300; a busy match day mails a
# dozen addresses per game) and the test scoresheets scorers send themselves
# (default 50). A final scoresheet the budget holds back is sent later, never
# dropped (lib/finalMail.js). A whole number above 0; anything else keeps the
# default and logs a warning at startup.
MAIL_BUDGET_FINAL=
MAIL_BUDGET_TEST=
# The account mails, each its own budget (defaults in brackets): reset and
# password-changed (50), confirmation links (150; one held back is sent when
# the window ends), club and team notices (100), sign-up notices to admins and
# approvers (100), the "your approval PIN was used" notices (50, reserved for
# them), the locked / blocked approval-PIN notices (50, their own, so wrong
# PINs cannot use up the first), and the game PIN / match information mails
# scorers ask for to their own address (100; also 5 an hour per inbox, apart
# from the reset mails). A budget used up logs one "[mail] ALERT" line per
# hour.
MAIL_BUDGET_ACCOUNT=
MAIL_BUDGET_CONFIRM=
MAIL_BUDGET_NOTIFY=
MAIL_BUDGET_SIGNUP=
MAIL_BUDGET_SECURITY=
MAIL_BUDGET_PIN_LOCK=
MAIL_BUDGET_USER=
# The error tracker (db/050, lib/errorTracker.js, lib/errorAlerts.js): every
# page's, app's and the server's own errors, triaged in the manager's Errors
# tab (super admins). A digest of new errors, errors back after "resolved" and
# errors still happening a day later goes out at most 6 times an hour, an error
# kind at most once an hour:
#   ERROR_ALERTS        on (default) | log (nothing sent, the log says what) | off (no digest)
#   ERROR_ALERT_EMAIL   the digest's recipient (admin@openvolley.app), through the
#                       SMTP account above; empty: no mail. Roles and clubs only,
#                       never a member's name or address.
#   NTFY_URL, NTFY_TOPIC  the phone push (ntfy; e.g. the tailnet ntfy and
#                       openvolley-errors); empty: no push. NTFY_TOKEN: the topic's
#                       access token if it needs one (secret, single-quoted).
#   NTFY_ADDRESS        optional: the address to connect to for NTFY_URL's host (TLS
#                       and Host keep the name). The tailnet ntfy's *.ts.net name
#                       resolves to public addresses outside MagicDNS: put its
#                       tailnet IP here.
#   The bell: every super admin, in the manager.
#   ERROR_SOURCE_MAPS   on (default) | off: readable stacks from the web builds'
#                       hidden source maps, fetched from the app's own sites
#                       (lib/sourceMaps.js; at most 4 maps of 20 MB kept)
#   OV_ERRORS_MAX_BYTES optional: what the error tables may hold, in bytes
#                       (default 536870912 = 512 MB; 0 = no ceiling). Past it
#                       reports are counted, not stored (they share the match
#                       records' volume); reports without a session past 60 %
#                       of it, so signed-in ones and server errors keep the rest.
ERROR_ALERTS=
ERROR_ALERT_EMAIL=admin@openvolley.app
NTFY_URL=
NTFY_TOPIC=openvolley-errors
NTFY_TOKEN=
NTFY_ADDRESS=

# The support mailbox (FreeScout reads it; default support@openvolley.app).
# The support form /api/contact mails only this address, through the SMTP
# account above (From MAIL_FROM, Reply-To the user).
CONTACT_EMAIL=

# Passkeys (backend/lib/passkeys.js). Both optional: the relying party is
# openvolley.app and only the app's own sites may ask (the exact https origins
# of lib/cors.js ALLOWED_ORIGINS; never the support desk, the download host or
# a dev build). WEBAUTHN_ORIGINS (comma list) replaces that list. Changing the
# RP ID orphans every passkey already set up.
# WEBAUTHN_RP_ID=openvolley.app
# WEBAUTHN_ORIGINS=

# --- VolleyManager -> svrz_games daily sync (22:30 UTC) ----------------------
# Replaces the Supabase vm-sync Edge Function. Leave the credentials empty to
# keep the sync off; VM_SYNC=off also disables it. A run that is no success is
# tried again after 15, 30 and 60 min, and a backend started with the last
# success over 26 h old catches up, both only inside VM_SYNC_WINDOW_UTC
# (default 22:00-01:00, the shared account's referee-role hours; 'any' once
# OpenVolley has an account of its own). /health shows it as vmSync.
VM_USERNAME=
VM_PASSWORD=
VM_SYNC=on
VM_SYNC_DAYS_BACK=1
VM_SYNC_DAYS_AHEAD=14
VM_SYNC_WINDOW_UTC=
# The account's referee-delegate role attribute (per account; empty = the
# shared account's, lib/vmSync.js VM_ROLE_FOR_GAMES)
VM_ROLE_ATTRIBUTE_GAMES=

# --- PINs at rest / match access (backend README "Security model") -----------
# OV_PIN_SECRET: game and connection PINs are stored as an HMAC with it.
# Generate once (openssl rand -base64 48), keep it with the DB credentials and
# NEVER change or lose it: hashed PINs cannot be checked without it. Then run
# `docker exec ov-backend node scripts/hash-pins.mjs --apply` once.
# Required: the backend does not start without it (compose refuses an empty one).
OV_PIN_SECRET=
# Match access tokens of the PIN checks (at least 32 characters, shorter stops
# the start); empty = derived from OV_PIN_SECRET, or random per backend start
# when that is empty too (tokens then end with a restart).
OV_MATCH_TOKEN_SECRET=
# Wrong PINs from all callers together (backend README, rate limits) within
# 10 minutes: per match and PIN type (default 30; restore-by-pin: per game
# number), and per sport and PIN type for the lookups that name no match
# (default 100). Past them one ops alert ("[PIN] ... from all callers" and an
# error-tracker event); nobody is refused for it, only an address range past
# its own share is (OV_PIN_RANGE_FAILURES, owner decision 2026-11: lock the
# guessers only). Empty = the default.
OV_PIN_MATCH_FAILURES=
OV_PIN_SEARCH_FAILURES=
# The referee and bench PIN checks that name no match (one guess tested
# against every open match of a sport; older apps still send them):
#   on     (empty, default) both sports, as OpenVolley 3.x and the current
#          OpenBeach release need
#   beach  OpenBeach only: indoor checks must name their match
#   off    none
# A refused check answers 409 match-required (the apps ask for the game in
# the list). Switch it with the post-release checklist (deploy/README.md):
# beach once the OpenVolley apps without the match are gone, off once the
# OpenBeach release that names its match has replaced the current one.
OV_PIN_ONLY_LOOKUP=
# A beach referee slot's account approval (lib/approvals.js, PERM-08):
#   optional (empty, default) a slot whose match setup stored no address
#            keeps the older rule (any beach:referee account not on the
#            scoring side), as the OpenBeach builds that store none need
#   required the slot needs the stored address, as an indoor slot does
#            (owner decision 6), once the OpenBeach release that stores
#            officials[].email has replaced them (deploy/README.md checklist)
OV_BEACH_REFEREE_ADDRESS=

# --- Misc backend settings ----------------------------------------------------
# OV_SIGNUP_LICENCE: sign-up needs a licence number (4 to 7 digits) unless this
# is `optional` (backend README). Leave empty in production.
OV_SIGNUP_LICENCE=
# REOPEN_PASSWORD_HASH is gone: reopening a closed match is an admin action in
# the app (POST /api/admin/matches/:id/reopen, audit-logged; db/007).

# --- Vector PDF (ov-render; field-spec 17.20, README.md "Vector PDF") --------
# The official scoresheet printed by headless Chromium as a vector PDF instead
# of the device's picture of the sheet. All empty = off (as before). On:
#   1. build-render-image.sh --ship ov-vps, OV_RENDER_IMAGE=openvolley-render:<sha>
#   2. OV_RENDER_TOKEN = openssl rand -hex 24 (the backend and ov-render share it)
#   3. COMPOSE_PROFILES=tunnel,render and OV_RENDER_URL=http://ov-render:8090
#   4. docker compose up -d
OV_RENDER_IMAGE=
OV_RENDER_TOKEN=
OV_RENDER_URL=
# empty = 768m, 1 CPU (one Chromium page at a time)
OV_RENDER_MEM=
OV_RENDER_CPUS=
