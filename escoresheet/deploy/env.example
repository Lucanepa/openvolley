# Template for /opt/openvolley/.env
#   install -m 600 env.example .env   (then fill it in; owner root)
#
# Read by `docker compose` for interpolation only. Each container receives
# just the variables compose.yaml hands it: the tunnel token never reaches the
# backend, the owner password never reaches the backend or the tunnel.
#
# NEVER `source` / `set -a; . .env` this file into a shell. Docker Compose
# gives variables exported in the calling shell priority over .env, so in that
# shell every later `docker compose up` silently keeps the exported values
# (an edited OV_BACKEND_IMAGE or OV_MIN_MATCHES would be ignored). Scripts that
# need one value (apply-roles.sh) extract just that value.
#
# Generate passwords as hex so they are safe inside DATABASE_URL:
#   openssl rand -hex 32

# --- Images -----------------------------------------------------------------
# Built on lenovoserver with build-image.sh and loaded here; tag = git short SHA.
# Rollback = put the previous tag back and `docker compose up -d ov-backend`.
OV_BACKEND_IMAGE=openvolley-backend:REPLACE_WITH_GIT_SHA
OV_POSTGRES_IMAGE=postgres:17.11-alpine
OV_CLOUDFLARED_IMAGE=cloudflare/cloudflared:2026.5.2

# --- Host paths (host-prep.sh creates them) -----------------------------------
# Loop filesystem mountpoints; each contains a .ovdata sentinel when mounted.
OV_PG_HOST_DIR=/data/openvolley/pg
OV_STORAGE_HOST_DIR=/data/openvolley/storage
# Holds last_backup (written by backup-openvolley.sh), mounted read-only.
OV_STATUS_HOST_DIR=/var/lib/openvolley-status

# --- Postgres ---------------------------------------------------------------
# Superuser of the OpenVolley cluster: restores, roles.sql, backups (docker exec).
OV_OWNER_PW=
# Login of the backend (role ov_app, created/updated by db/roles.sql).
OV_APP_PW=
# /health "floor": 90% of the matches count after the production restore.
OV_MIN_MATCHES=0

# --- Cloudflare Tunnel ------------------------------------------------------
# `cloudflared tunnel token openvolley` on lenovoserver. Same token on any VM
# that runs this stack (that is how a move needs no DNS change).
TUNNEL_TOKEN=

# --- Backend (HTTP + WS on port 8080 inside the compose network) -------------
# Comma-separated list of allowed browser origins (CORS).
PUBLIC_ORIGINS=https://app.openvolley.app,https://referee.openvolley.app,https://bench.openvolley.app,https://livescore.openvolley.app,https://roster.openvolley.app,https://scoresheet.openvolley.app,https://beach.openvolley.app,https://manager.openvolley.app
# DATABASE_URL, STORAGE_ROOT, STATUS_DIR, PORT and TRUST_PROXY=cloudflare are
# fixed in compose.yaml and are not read from here.

# --- Mail --------------------------------------------------------------------
RESEND_API_KEY=
# Quoted: unquoted, the '<' would make the line a shell syntax error.
RESEND_FROM='eScoresheet <escoresheet@openvolley.app>'
# Account emails (backend README "Account emails"): password-reset links,
# confirmation links for new accounts, "your password was changed" notices.
# Without SMTP_HOST or SMTP_PASS the backend sends none: reset answers 503
# ("temporarily unavailable, contact CONTACT_EMAIL") and sign-up confirms the
# account at once. Set them with ~/ov-ops/set-smtp-password.sh (lenovoserver),
# which keeps the password in Vaultwarden and out of shell history.
#   SMTP_PORT  465 = implicit TLS (default); 587 = STARTTLS (required). Hetzner
#              blocks outgoing 465 on new servers: use 587 if 465 times out.
#   SMTP_PASS  the mailbox password. Single-quoted, no ' in it.
#   MAIL_FROM  quoted (contains < >); default: OpenVolley <SMTP_USER>
#   MANAGER_URL base of the links in the mails (default below)
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=
MAIL_FROM='OpenVolley <noreply@openvolley.app>'
MANAGER_URL=https://manager.openvolley.app
# 1 = also let the legacy /api/contact and /api/match/send-info routes send
# through this SMTP account. Off by default: both mail addresses supplied by
# anonymous requests (an open relay of the noreply mailbox).
SMTP_LEGACY_ROUTES=
CONTACT_EMAIL=

# --- VolleyManager -> svrz_games daily sync (06:00 Europe/Zurich) ----------
# Replaces the Supabase vm-sync Edge Function. Leave the credentials empty to
# keep the sync off; VM_SYNC=off also disables it.
VM_USERNAME=
VM_PASSWORD=
VM_SYNC=on
VM_SYNC_DAYS_BACK=1
VM_SYNC_DAYS_AHEAD=14

# --- PINs at rest / match access (backend README "Security model") -----------
# OV_PIN_SECRET: game and connection PINs are stored as an HMAC with it.
# Generate once (openssl rand -base64 48), keep it with the DB credentials and
# NEVER change or lose it: hashed PINs cannot be checked without it. Then run
# `docker exec ov-backend node scripts/hash-pins.mjs --apply` once.
# Empty: PINs stay plaintext in the database (the backend warns).
OV_PIN_SECRET=
# Match access tokens of the PIN checks (at least 32 characters, shorter stops
# the start); empty = derived from OV_PIN_SECRET, or random per backend start
# when that is empty too (tokens then end with a restart).
OV_MATCH_TOKEN_SECRET=

# --- Misc backend settings ----------------------------------------------------
# REOPEN_PASSWORD_HASH is gone: reopening a closed match is an admin action in
# the app (POST /api/admin/matches/:id/reopen, audit-logged; db/007).
