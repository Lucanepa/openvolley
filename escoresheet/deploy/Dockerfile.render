# syntax=docker/dockerfile:1
#
# openvolley-render: the backend's vector scoresheet PDF (field-spec 17.19).
# Headless Chromium prints the scoresheet page built from the web app's own
# code (frontend/render) with page.pdf(). Built by build-render-image.sh from
# a context holding the COMMITTED frontend/ and render/ trees:
#
#   escoresheet/deploy/build-render-image.sh [--ship ov-vps]
#
# Runtime contract: PORT (8090), OV_RENDER_TOKEN (shared with the backend),
# OV_RENDER_TIMEOUT_MS, OV_RENDER_QUEUE, OV_TIMEZONE. It runs on the backend's
# private network only (compose ov-render-net, internal: true): no egress, no
# published port. The container is Chromium's sandbox (--no-sandbox inside:
# no capabilities, read-only root, its own memory limit).

ARG NODE_IMAGE=node:22.23.3-bookworm-slim

# 1. the scoresheet page (dist-render/), from the committed frontend sources
FROM ${NODE_IMAGE} AS page
WORKDIR /src/frontend
COPY frontend/package.json frontend/package-lock.json ./
RUN npm ci --ignore-scripts --no-audit --no-fund
COPY frontend/ ./
RUN npx vite build --config vite.render.config.js \
 && test -s dist-render/render/index.html

# 2. the service: Node + Playwright's headless Chromium + its libraries
FROM ${NODE_IMAGE}
ARG OV_REVISION=unknown
LABEL org.opencontainers.image.title="openvolley-render" \
      org.opencontainers.image.source="https://github.com/Lucanepa/openvolley" \
      org.opencontainers.image.revision="${OV_REVISION}"
ENV NODE_ENV=production \
    PORT=8090 \
    OV_RENDER_DIST=/app/dist-render \
    PLAYWRIGHT_BROWSERS_PATH=/ms-playwright \
    OV_REVISION=${OV_REVISION} \
    NPM_CONFIG_UPDATE_NOTIFIER=false
WORKDIR /app
COPY render/package.json render/package-lock.json ./
# chromium-headless-shell with the system libraries it needs (--with-deps runs
# apt); Liberation fonts for the sheet's monospace clocks (the sheet's own
# font, Inter, comes with the page)
RUN npm ci --omit=dev --ignore-scripts --no-audit --no-fund \
 && npx playwright-core install --with-deps chromium-headless-shell \
 && apt-get update && apt-get install -y --no-install-recommends fonts-liberation \
 && rm -rf /var/lib/apt/lists/* /root/.cache /tmp/* \
 && npm cache clean --force \
 && chmod -R a+rX /ms-playwright
COPY render/server.mjs ./
COPY render/lib ./lib
COPY --from=page /src/frontend/dist-render ./dist-render
USER node
EXPOSE 8090
HEALTHCHECK --interval=30s --timeout=5s --start-period=20s --retries=3 \
  CMD ["node", "-e", "fetch('http://127.0.0.1:8090/health',{signal:AbortSignal.timeout(4000)}).then(r=>process.exit(r.ok?0:1)).catch(()=>process.exit(1))"]
CMD ["node", "server.mjs"]
