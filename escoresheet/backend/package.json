{
  "name": "escoresheet-backend",
  "version": "1.0.0",
  "type": "module",
  "description": "Backend server for eScoresheet with WebSocket support",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "start:local": "node server.js --local",
    "build": "node build-server.js",
    "build:bundle": "npx esbuild server.js --bundle --platform=node --target=node22 --format=cjs --outfile=dist/server.bundle.cjs --external:bufferutil --external:utf-8-validate",
    "test": "node --test tests/*.test.js"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.97.0",
    "cors": "^2.8.5",
    "node-ical": "^0.22.1",
    "nodemailer": "^6.10.1",
    "pocketbase": "^0.26.8",
    "qrcode": "^1.5.4",
    "ws": "^8.18.3"
  },
  "devDependencies": {
    "esbuild": "^0.25.0",
    "postject": "^1.0.0-alpha.6"
  },
  "engines": {
    "node": ">=22.0.0"
  }
}
