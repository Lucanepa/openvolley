{
  "name": "escoresheet-backend",
  "version": "1.0.0",
  "type": "module",
  "description": "Backend server for eScoresheet with WebSocket support",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "start:local": "node server.js --local",
    "build": "node build-server.js",
    "build:bundle": "npx esbuild server.js --bundle --platform=node --target=node22 --format=cjs --outfile=dist/server.bundle.cjs --external:bufferutil --external:utf-8-validate --external:pg-native --define:import.meta.url=__import_meta_url \"--banner:js=const __import_meta_url = require('url').pathToFileURL(__filename).href;\"",
    "test": "node --test tests/*.test.js"
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.5",
    "node-ical": "^0.22.1",
    "nodemailer": "^10.1.0",
    "pg": "^8.23.1",
    "pocketbase": "^0.26.8",
    "qrcode": "^1.5.4",
    "ws": "^8.21.0"
  },
  "devDependencies": {
    "esbuild": "^0.25.0",
    "postject": "^1.0.0-alpha.6",
    "smtp-server": "^3.19.17"
  },
  "engines": {
    "node": ">=22.0.0"
  }
}
