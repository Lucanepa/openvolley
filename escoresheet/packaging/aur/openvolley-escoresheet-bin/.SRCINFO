pkgbase = openvolley-escoresheet-bin
	pkgdesc = Open source volleyball eScoresheet: offline scoretable with a LAN server for referee, bench and livescore tablets
	pkgver = 3.0.2
	pkgrel = 1
	url = https://openvolley.app
	arch = x86_64
	license = GPL-3.0-or-later
	depends = cairo
	depends = dbus
	depends = gdk-pixbuf2
	depends = glib2
	depends = glibc
	depends = gtk3
	depends = hicolor-icon-theme
	depends = libayatana-appindicator
	depends = libgcc
	depends = libsoup3
	depends = webkit2gtk-4.1
	optdepends = networkmanager: the tablet Wi-Fi (hotspot) and Bluetooth network the app can start
	optdepends = bluez: the Bluetooth network for tablets (with NetworkManager)
	optdepends = dnsmasq: addresses for the tablets on the hotspot (NetworkManager shared mode)
	optdepends = xdg-utils: open links, the PDF and the backup folder
	provides = openvolley-escoresheet
	conflicts = openvolley-escoresheet
	noextract = openvolley-escoresheet-3.0.2-amd64.deb
	options = !strip
