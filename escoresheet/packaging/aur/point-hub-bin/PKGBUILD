# Maintainer: Luca Canepa
#
# Point Hub, KSC Wiedikon's scoreboard console. Repackages the .deb that
# point-hub's GitHub Actions build and release (github.com/Lucanepa/point-hub,
# .github/workflows/desktop.yml, tag desktop-v$pkgver). Packaging notes:
# https://github.com/Lucanepa/openvolley/tree/main/escoresheet/packaging/aur
# A new release: escoresheet/packaging/aur/bump.sh point-hub <version>

pkgname=point-hub-bin
_pkgname=point-hub
pkgver=1.1.1
pkgrel=1
pkgdesc='Point Hub: the console of the KSCW LedBox scoreboard'
arch=('x86_64')
url='https://github.com/Lucanepa/point-hub'
license=('MIT')
# What the bundle's own Java runtime and Chromium (JCEF) link from the system;
# everything else is in /opt/point-hub.
depends=(
  'alsa-lib'
  'at-spi2-core'
  'cairo'
  'dbus'
  'expat'
  'fontconfig'
  'freetype2'
  'glib2'
  'glibc'
  'hicolor-icon-theme'
  'libcups'
  'libdrm'
  'libgcc'
  'libglvnd'
  'libstdc++'
  'libx11'
  'libxcb'
  'libxcomposite'
  'libxcursor'
  'libxdamage'
  'libxext'
  'libxfixes'
  'libxi'
  'libxkbcommon'
  'libxrandr'
  'libxrender'
  'libxtst'
  'libxxf86vm'
  'mesa'
  'nspr'
  'nss'
  'pango'
  'systemd-libs'
  'ttf-font' # Compose draws with a system font: without any, the app stops at start (FontFamily.Default)
  'wayland'
  'zlib'
)
optdepends=(
  'xdg-utils: open links from the console in the browser'
)
provides=("$_pkgname")
conflicts=("$_pkgname")
# Prebuilt: stripping would change the bundle's binaries (skiko checks its
# library against the .sha256 file next to it).
options=('!strip' '!debug')
source=("LICENSE-$pkgver::https://raw.githubusercontent.com/Lucanepa/point-hub/desktop-v$pkgver/LICENSE")
source_x86_64=("$_pkgname-$pkgver-amd64.deb::https://github.com/Lucanepa/point-hub/releases/download/desktop-v$pkgver/${_pkgname}_${pkgver}_amd64.deb")
noextract=("$_pkgname-$pkgver-amd64.deb")
# bump.sh fills these in from the release. Before the first release they are
# the @SHA256@ placeholder, which makepkg, publish.sh and publish-pacman.sh refuse.
sha256sums=('c8f59120a0fb511bba6e6f34968f5c62d8b636d6ee6377fbbaa8a8ead0a0bc66')
sha256sums_x86_64=('585e190933175cbebdce3dfa11fd07f9b9a4b2d8a629e4218aec9337d88cc7d2')

prepare() {
  rm -rf deb
  mkdir deb
  bsdtar -xOf "$_pkgname-$pkgver-amd64.deb" 'data.tar.*' | bsdtar -xf - -C deb
  if [[ ! -x deb/opt/point-hub/bin/point-hub ]]; then
    echo "no /opt/point-hub/bin/point-hub (jpackage's launcher) in the .deb" >&2
    return 1
  fi
}

package() {
  # jpackage's self-contained bundle (launcher, Java runtime, Chromium) as it
  # is: the launcher finds its runtime next to itself.
  install -d "$pkgdir/opt"
  cp -dR --preserve=mode,timestamps deb/opt/point-hub "$pkgdir/opt/"
  install -d "$pkgdir/usr/bin"
  ln -s /opt/point-hub/bin/point-hub "$pkgdir/usr/bin/$_pkgname"
  # A menu entry of our own: the .deb installs jpackage's (named "point-hub",
  # icon by absolute path) from its postinst with xdg-desktop-menu.
  install -Dm644 /dev/stdin "$pkgdir/usr/share/applications/$_pkgname.desktop" <<'DESKTOP'
[Desktop Entry]
Type=Application
Name=Point Hub
GenericName=Scoreboard console
Comment=The console of the KSCW LedBox scoreboard
Keywords=scoreboard;volleyball;LedBox;KSCW;score;match;
Categories=Utility;Sports;
Exec=point-hub
Icon=point-hub
Terminal=false
SingleMainWindow=true
DESKTOP
  install -Dm644 deb/opt/point-hub/lib/point-hub.png \
    "$pkgdir/usr/share/icons/hicolor/512x512/apps/$_pkgname.png"
  install -Dm644 "LICENSE-$pkgver" "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
  # No updater marker (/usr/lib/<command>/package-manager, as in the other two
  # packages): Point Hub has no in-app updater; pacman updates it.
}
